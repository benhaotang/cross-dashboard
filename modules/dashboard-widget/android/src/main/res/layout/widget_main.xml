<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_main_bg">

    <!-- UPCOMING section header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPCOMING"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_header_text"
        android:letterSpacing="0.1"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/main_event_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_event_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_event_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_events_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No upcoming events"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!-- OVERDUE section header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OVERDUE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_header_text"
        android:letterSpacing="0.1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/main_overdue_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_overdue_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_overdue_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_overdue_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_overdue_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_overdue_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/main_overdue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All caught up!"
        android:textSize="11sp"
        android:textColor="@color/widget_empty_text"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!-- Flexible spacer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom bar: 3 stat buttons + pen FAB -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <!-- Events remaining today -->
            <LinearLayout
                android:id="@+id/stat_events_btn"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/stat_btn_bg"
                android:layout_marginEnd="4dp">
                <TextView
                    android:id="@+id/stat_events_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_stat_text" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="today"
                    android:textSize="8sp"
                    android:textColor="@color/widget_header_text" />
            </LinearLayout>

            <!-- Pomodoro sessions today -->
            <LinearLayout
                android:id="@+id/stat_pomodoro_btn"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/stat_btn_bg"
                android:layout_marginEnd="4dp">
                <TextView
                    android:id="@+id/stat_pomodoro_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_stat_text" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pomodoro"
                    android:textSize="8sp"
                    android:textColor="@color/widget_header_text" />
            </LinearLayout>

            <!-- Open issues -->
            <LinearLayout
                android:id="@+id/stat_issues_btn"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/stat_btn_bg">
                <TextView
                    android:id="@+id/stat_issues_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_stat_text" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="issues"
                    android:textSize="8sp"
                    android:textColor="@color/widget_header_text" />
            </LinearLayout>

        </LinearLayout>

        <!-- Pen FAB: quick add task (bottom-right) -->
        <TextView
            android:id="@+id/main_pen_fab"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="&#x270F;"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/pen_fab_bg"
            android:gravity="center"
            android:paddingBottom="2dp" />

    </RelativeLayout>

</LinearLayout>
