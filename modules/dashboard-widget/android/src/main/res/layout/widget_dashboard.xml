<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="#F5F5F5">

    <!-- Main content column -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- EVENTS section header -->
        <TextView
            android:id="@+id/widget_events_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EVENTS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/widget_event_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_event_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_event_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_events_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No upcoming events"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <!-- TASKS section header -->
        <TextView
            android:id="@+id/widget_tasks_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TASKS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:letterSpacing="0.1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/widget_task_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_task_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_task_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_tasks_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending tasks"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="1dp"
            android:visibility="gone" />

        <!-- Spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer: issues count + last sync -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_issues_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="10sp"
                android:textColor="#9C27B0" />

            <TextView
                android:id="@+id/widget_last_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not synced"
                android:textSize="9sp"
                android:textColor="#BBBBBB"
                android:layout_marginEnd="88dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Sync FAB: force refresh widget data -->
    <TextView
        android:id="@+id/widget_sync_fab"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="44dp"
        android:text="&#x21BB;"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/sync_fab_background"
        android:gravity="center" />

    <!-- FAB: add task (TextView avoids MaterialButton inflation via app theme) -->
    <TextView
        android:id="@+id/widget_fab"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="2dp"
        android:text="+"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/fab_background"
        android:gravity="center"
        android:paddingBottom="2dp" />

</RelativeLayout>
