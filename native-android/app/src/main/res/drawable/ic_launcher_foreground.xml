<?xml version="1.0" encoding="utf-8"?>
<!--
  Cross-Dashboard adaptive icon foreground.
  Design: A stylised dashboard showing 3 panes:
    - Top-left card (events/calendar: tiny grid)
    - Top-right card (tasks: checkmark)
    - Bottom wide card (issues/activity bar)
  Drawn on a 108×108dp canvas with 18dp safe-zone padding on each side
  (72dp safe zone = range 18–90dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top-left card: Events (calendar icon) -->
    <path
        android:pathData="M22,24 h26 a4,4 0 0,1 4,4 v22 a4,4 0 0,1 -4,4 H22 a4,4 0 0,1 -4,-4 V28 a4,4 0 0,1 4,-4 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95" />
    <!-- Calendar header strip -->
    <path
        android:pathData="M18,32 h34 v3 H18 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.25" />
    <!-- Calendar dots (3×2 grid) -->
    <path
        android:pathData="M24,39 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z
                          M30,39 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z
                          M36,39 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z
                          M24,46 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z
                          M30,46 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z
                          M36,46 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0 Z"
        android:fillColor="#1B6AC9" />

    <!-- Top-right card: Tasks (checkbox checkmark) -->
    <path
        android:pathData="M60,24 h26 a4,4 0 0,1 4,4 v22 a4,4 0 0,1 -4,4 H60 a4,4 0 0,1 -4,-4 V28 a4,4 0 0,1 4,-4 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95" />
    <!-- Checkbox outline -->
    <path
        android:pathData="M66,33 h16 a3,3 0 0,1 3,3 v16 a3,3 0 0,1 -3,3 H66 a3,3 0 0,1 -3,-3 V36 a3,3 0 0,1 3,-3 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#1B6AC9"
        android:strokeWidth="2.5" />
    <!-- Checkmark -->
    <path
        android:pathData="M67.5,42 L71.5,46.5 L80.5,37"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#1B6AC9"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom wide card: Activity (bar chart representing issues/stats) -->
    <path
        android:pathData="M18,62 h72 a4,4 0 0,1 4,4 v18 a4,4 0 0,1 -4,4 H18 a4,4 0 0,1 -4,-4 V66 a4,4 0 0,1 4,-4 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95" />
    <!-- Bar chart bars (varying heights, left aligned) -->
    <path
        android:pathData="M24,80 v-10 h5 v10 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.8" />
    <path
        android:pathData="M33,80 v-15 h5 v15 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.9" />
    <path
        android:pathData="M42,80 v-7 h5 v7 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.7" />
    <path
        android:pathData="M51,80 v-12 h5 v12 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.85" />
    <path
        android:pathData="M60,80 v-16 h5 v16 Z"
        android:fillColor="#1B6AC9" />
    <path
        android:pathData="M69,80 v-9 h5 v9 Z"
        android:fillColor="#1B6AC9"
        android:fillAlpha="0.75" />

</vector>
