<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the widget picker (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?android:attr/colorBackground">

    <!-- Events section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_events_section"
        android:textAppearance="@android:style/TextAppearance.Material.Small"
        android:textAllCaps="true"
        android:alpha="0.6" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="09:00  Team standup"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="14:00  Design review"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?android:attr/listDivider" />

    <!-- Tasks section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_tasks_section"
        android:textAppearance="@android:style/TextAppearance.Material.Small"
        android:textAllCaps="true"
        android:alpha="0.6" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Write release notes"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="⚠ Fix login bug"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />

</LinearLayout>
